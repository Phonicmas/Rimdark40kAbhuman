<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Beastman shaman duty at the raid herdstone.
    Priority order matters: fight fires, shoot anything that comes into bow range without ever
    leaving the stone, then chant at an assigned spot. The pray node returns null while the
    stone is still a blueprint, so the shamans fall through to the work node and build it first.
    JobGiver_AIDefendPoint reads its acquire/keep radius from the duty radius set in
    LordToil_Beastman.SetAsShaman, which is what keeps them from ever joining an assault.
  -->
  <DutyDef>
    <defName>BEWH_BestmanShamanChant</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_FightFiresNearPoint">
          <maxDistFromPoint>20</maxDistFromPoint>
        </li>
        <li Class="JobGiver_AIDefendPoint">
          <targetAcquireRadius>24</targetAcquireRadius>
          <targetKeepRadius>30</targetKeepRadius>
        </li>
        <li Class="Abhuman40k.JobGiver_HerdstonePray" />
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>25</maxDistToSquadFlag>
          <subNodes>
            <li Class="JobGiver_Work" />
          </subNodes>
        </li>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>25</maxDistToSquadFlag>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>SatisfyBasicNeedsAndWork</treeDef>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_StandAndStare" />
      </subNodes>
    </thinkNode>
  </DutyDef>

</Defs>
