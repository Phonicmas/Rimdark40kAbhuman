<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StorytellerDef[@Name="BaseStoryteller"]/comps</xpath>
        <value>
            <li Class="Abhuman40k.StorytellerCompProperties_NavigatorDowned">
                <fireAfterDaysPassed>50</fireAfterDaysPassed>
                <retryDelayDays>30</retryDelayDays>
                <incident>BEWH_NavigatorDowned</incident>
                <skipIfOnExtremeBiome>true</skipIfOnExtremeBiome>
                <allowedTargetTags>
                    <li>World</li>
                </allowedTargetTags>
            </li>
        </value>
    </Operation>

</Patch>