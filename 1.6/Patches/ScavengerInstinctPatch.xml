<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThoughtDef[defName="DeadMansApparel"]/nullifyingGenes</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/ThoughtDef[defName="DeadMansApparel"]/nullifyingGenes</xpath>
            <value>
                <li>BEWH_RatlingScavengerInstinct</li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThoughtDef[defName="DeadMansApparel"]</xpath>
            <value>
                <nullifyingGenes>
                    <li>BEWH_RatlingScavengerInstinct</li>
                </nullifyingGenes>
            </value>
        </nomatch>
    </Operation>

</Patch>
